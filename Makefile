.DEFAULT_GOAL := all

BUILD_ROOT ?= build

MAKEFLAGS += --no-print-directory

ifeq ($(V),1)
Q :=
else
MAKEFLAGS += --silent
Q := @
endif

ARCH ?= riscv

KBUILD_CFLAGS :=
KBUILD_LDFLAGS :=
CFLAGS ?=
LDFLAGS ?=
LDFLAGS_FINAL :=

ifeq ($(ARCH),riscv)
include arch/$(ARCH)/config.mk
else
$(error Unsupported architecture '$(ARCH)')
endif

BUILD ?= debug
WERROR ?= 1
KERNEL_BUILD_ROOT ?= $(BUILD_ROOT)/$(ARCH)/$(BUILD)

CROSS_COMPILE ?=

# Respect CC/LD/... from the environment or the command line, but replace
# make's built-in defaults (cc/ld/...) with the cross-toolchain equivalents.
ifeq ($(origin CC),default)
CC := $(CROSS_COMPILE)gcc
endif
CPP := $(CC) -E
ifeq ($(origin LD),default)
LD := $(CROSS_COMPILE)ld
endif
ifeq ($(origin AS),default)
AS := $(CROSS_COMPILE)as
endif
ifeq ($(origin AR),default)
AR := $(CROSS_COMPILE)ar
endif
OBJCOPY ?= $(CROSS_COMPILE)objcopy
OBJDUMP ?= $(CROSS_COMPILE)objdump
SIZE ?= $(CROSS_COMPILE)size

KBUILD_CFLAGS += -Wall
KBUILD_CFLAGS += -Wextra
KBUILD_CFLAGS += -Wundef
KBUILD_CFLAGS += -Wvla
KBUILD_CFLAGS += -Wformat=2
KBUILD_CFLAGS += -Wimplicit-fallthrough
KBUILD_CFLAGS += -Wframe-larger-than=4096
KBUILD_CFLAGS += -Wstack-usage=4096
ifeq ($(WERROR),1)
KBUILD_CFLAGS += -Werror
endif
KBUILD_CFLAGS += -ffreestanding
KBUILD_CFLAGS += -fno-common
KBUILD_CFLAGS += -fno-strict-aliasing
KBUILD_CFLAGS += -fno-delete-null-pointer-checks
KBUILD_CFLAGS += -nostdlib
KBUILD_CFLAGS += -fno-stack-protector
KBUILD_CFLAGS += -fno-pie
KBUILD_CFLAGS += -no-pie

ifeq ($(BUILD),debug)
KBUILD_CFLAGS += -Og
KBUILD_CFLAGS += -ggdb
KBUILD_CFLAGS += -gdwarf-4
KBUILD_CFLAGS += -fno-omit-frame-pointer
else ifeq ($(BUILD),release)
KBUILD_CFLAGS += -O2
KBUILD_CFLAGS += -DNDEBUG
KBUILD_CFLAGS += -fomit-frame-pointer
KBUILD_CFLAGS += -fno-semantic-interposition
KBUILD_CFLAGS += -fno-unwind-tables
KBUILD_CFLAGS += -fno-asynchronous-unwind-tables
KBUILD_CFLAGS += -ffunction-sections
KBUILD_CFLAGS += -fdata-sections
LDFLAGS_FINAL += --gc-sections
else
$(error Unknown build type '$(BUILD)')
endif

KBUILD_CFLAGS += -std=gnu11

KBUILD_CFLAGS += -nostdinc
KBUILD_CFLAGS += -MMD
KBUILD_CFLAGS += -MP
KBUILD_CFLAGS += -Iarch/$(ARCH)/include
KBUILD_CFLAGS += -Iinclude
KBUILD_CFLAGS += -Ivendor/libfdt

KBUILD_LDFLAGS += -z max-page-size=4096

# User-supplied additions; use these instead of overriding CFLAGS/LDFLAGS,
# which would discard the flags assembled above.
KBUILD_CFLAGS += $(EXTRA_CFLAGS)
KBUILD_LDFLAGS += $(EXTRA_LDFLAGS)

# Command-line/environment CFLAGS/LDFLAGS are appended last so users can
# override individual options without discarding the kernel's own flags.
KBUILD_CFLAGS += $(CFLAGS)
KBUILD_LDFLAGS += $(LDFLAGS)

# Compiler runtime helpers (e.g. 128-bit division) not emitted natively.
LIBGCC := $(shell $(CC) $(KBUILD_CFLAGS) -print-libgcc-file-name 2>/dev/null)

# Goals that do not build kernel objects do not need the RISC-V toolchain.
# An empty MAKECMDGOALS means the default "all" target.
ifeq ($(MAKECMDGOALS),)
KERNEL_GOALS := all
else
KERNEL_GOALS := $(filter-out clean clean-kernel help headers-check \
	format format-check hooks,$(MAKECMDGOALS))
endif

# Fail early with a useful message instead of a wall of compiler errors.
ifneq ($(KERNEL_GOALS),)
ifeq ($(shell $(CC) -dumpmachine 2>/dev/null | grep -c '^riscv'),0)
$(error $(CC) is not a RISC-V compiler; set CROSS_COMPILE (e.g. riscv64-unknown-elf-))
endif
ifeq ($(strip $(LIBGCC)),)
$(error Cannot find libgcc for $(CC); set CROSS_COMPILE (e.g. riscv64-unknown-elf-))
endif
endif

# Rebuild objects when the compiler or flags change.  .build-flags.mk is
# regenerated by a makefile-remaking rule; the stamp is touched only when
# its contents actually change, so unchanged builds stay incremental.
FLAGS_STAMP := $(KERNEL_BUILD_ROOT)/.build-flags
FLAGS_DEP := $(wildcard $(FLAGS_STAMP))
FLAGS_CONFIG := $(KERNEL_BUILD_ROOT)/.build-flags.mk
FLAGS_SIGNATURE := ARCH=$(ARCH) BUILD=$(BUILD) CC=$(CC) LD=$(LD) \
	KBUILD_CFLAGS=$(KBUILD_CFLAGS) KBUILD_LDFLAGS=$(KBUILD_LDFLAGS) \
	CFLAGS=$(CFLAGS) LDFLAGS=$(LDFLAGS) \
	LDFLAGS_FINAL=$(LDFLAGS_FINAL) LIBGCC=$(LIBGCC) \
	LINK_CHECK=$(LINK_CHECK)
export ARCH
export BUILD_ROOT
export CROSS_COMPILE CC LD AS AR CFLAGS LDFLAGS KBUILD_CFLAGS KBUILD_LDFLAGS

ifneq ($(KERNEL_GOALS),)
ifneq ($(findstring n,$(firstword $(MAKEFLAGS))),)
# Dry run: make remakes included makefiles even with -n, so do not let the
# flag check rewrite the build stamp.
$(FLAGS_CONFIG): ;
else
$(FLAGS_CONFIG): FORCE
	@mkdir -p $(dir $@)
	@printf '# generated by the build system; do not edit\nFLAGS_CONFIG_SIGNATURE := %s\n' \
		'$(FLAGS_SIGNATURE)' > $@.tmp
	@if cmp -s $@.tmp $@; then \
		rm -f $@.tmp; \
		[ -e $(FLAGS_STAMP) ] || touch $(FLAGS_STAMP); \
	else \
		mv $@.tmp $@; \
		touch $(FLAGS_STAMP); \
	fi
endif
endif

LINKER_SCRIPT_SRC := arch/$(ARCH)/kernel/brk.ld.S
LINKER_SCRIPT := $(KERNEL_BUILD_ROOT)/brk.ld
LINKER_SCRIPT_DEP := $(LINKER_SCRIPT).d
KERNEL_ELF := $(KERNEL_BUILD_ROOT)/brk
KERNEL_MAP := $(KERNEL_ELF).map

LDFLAGS_FINAL += -Map=$(KERNEL_MAP)

# Opt-in: report sections that are not explicitly placed by the linker
# script.  This is noisy for the debug sections in libgcc, so keep it off by
# default and enable it with LINK_CHECK=1.
ifeq ($(LINK_CHECK),1)
LDFLAGS_FINAL += --orphan-handling=warn
endif

core-y := arch/$(ARCH)
core-y += kernel
core-y += mm
core-y += drivers
core-y += fs
core-y += net
core-y += lib
core-y += vendor

BUILT_IN_OBJS := $(addprefix $(KERNEL_BUILD_ROOT)/,$(patsubst %,%/built-in.o,$(core-y)))

.DELETE_ON_ERROR:

.PHONY: all brk clean clean-kernel \
	format format-check compile_commands size disasm syncconfig \
	distclean hooks help FORCE

all: brk

brk: $(KERNEL_ELF)

format:
	$(Q)./scripts/format_src.py

format-check:
	$(Q)./scripts/format_src.py --check

compile_commands:
	@command -v bear >/dev/null 2>&1 || \
		{ echo "error: bear not found in PATH" >&2; exit 1; }
	$(Q)bear --output compile_commands.json -- $(MAKE) -B brk

size: $(KERNEL_ELF)
	$(Q)$(SIZE) $<

disasm: $(KERNEL_ELF)
	$(Q)$(OBJDUMP) -d $< > $<.dis
	$(Q)echo "  DIS     $<.dis"

syncconfig:
	$(Q)rm -f $(FLAGS_CONFIG) $(FLAGS_STAMP)
	$(Q)echo "  SYNC    build flags will be regenerated on the next build"

hooks:
	$(Q)git config core.hooksPath .githooks
	$(Q)echo "  HOOK    core.hooksPath=.githooks"

help:
	$(Q)echo "Targets:"
	$(Q)echo "  all / brk              Build the kernel (SMP capable)"
	$(Q)echo "  format                 Format C sources with clang-format"
	$(Q)echo "  format-check           Check C source formatting (no writes)"
	$(Q)echo "  compile_commands       Regenerate compile_commands.json (needs bear)"
	$(Q)echo "  size / disasm          Show kernel size / disassembly"
	$(Q)echo "  syncconfig             Force build-flag regeneration"
	$(Q)echo "  hooks                  Enable the Conventional Commit hook"
	$(Q)echo "  clean                  Remove all build outputs"
	$(Q)echo "  distclean              clean + generated compile_commands.json"
	$(Q)echo "  clean-kernel           Remove current variant build directory"
	$(Q)echo ""
	$(Q)echo "Configurable vars:"
	$(Q)echo "  ARCH=<name>"
	$(Q)echo "  CROSS_COMPILE=<prefix>"
	$(Q)echo "  BUILD={debug|release}  (default: debug)"
	$(Q)echo "  BUILD_ROOT=<path>      (default: build)"
	$(Q)echo "  WERROR={0|1}           (default: 1)"
	$(Q)echo "  PGTABLE_LEVELS={3|4|5} (default: 3, Sv39/Sv48/Sv57)"
	$(Q)echo "  V=1                    Show full build commands"
	$(Q)echo "  EXTRA_CFLAGS=...       Additional compiler flags"
	$(Q)echo "  EXTRA_LDFLAGS=...      Additional linker flags"
	$(Q)echo "  LINK_CHECK={0|1}       Warn about linker orphan sections"

$(LINKER_SCRIPT): $(LINKER_SCRIPT_SRC) $(FLAGS_DEP) \
	$(if $(wildcard $(LINKER_SCRIPT_DEP)),,FORCE)
	$(Q)mkdir -p $(dir $@)
	$(Q)echo "  CPP     $@"
	$(Q)$(CPP) $(filter-out -MMD -MP,$(KBUILD_CFLAGS)) \
		-MD -MF $(LINKER_SCRIPT_DEP) -MT $@ -o $@ $<

$(KERNEL_ELF): $(BUILT_IN_OBJS) $(LINKER_SCRIPT) $(FLAGS_DEP)
	$(Q)echo "  LD      $@"
	$(Q)$(LD) $(KBUILD_LDFLAGS) $(LDFLAGS_FINAL) -T $(LINKER_SCRIPT) -static -o $@ $(BUILT_IN_OBJS) $(LIBGCC)

$(KERNEL_BUILD_ROOT)/%/built-in.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build build=$* \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

# Single-object convenience targets.  They build the whole directory, which
# is cheap and keeps the recursive Makefile logic in one place.
object_build = $(1)$(patsubst %/,%,/$(subst ./,,$(dir $*)))

$(KERNEL_BUILD_ROOT)/arch/$(ARCH)/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,arch/$(ARCH)) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/kernel/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,kernel) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/mm/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,mm) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/drivers/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,drivers) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/fs/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,fs) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/net/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,net) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/lib/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,lib) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

$(KERNEL_BUILD_ROOT)/vendor/%.o: FORCE
	$(Q)$(MAKE) -f scripts/Makefile.build \
		build=$(call object_build,vendor) \
		KERNEL_BUILD_ROOT=$(KERNEL_BUILD_ROOT) FLAGS_STAMP=$(FLAGS_STAMP)

clean:
	$(Q)$(RM) -r $(BUILD_ROOT)

clean-kernel:
	$(Q)$(RM) -r $(KERNEL_BUILD_ROOT)

distclean: clean
	$(Q)$(RM) compile_commands.json

ifneq ($(KERNEL_GOALS),)
-include $(FLAGS_CONFIG)
endif

-include $(LINKER_SCRIPT_DEP)
