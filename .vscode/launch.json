{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "riscv64",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/riscv/debug/brk",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "stopAtEntry": false,
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}