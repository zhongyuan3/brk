{
    "terminal.integrated.env.linux": {
        "CROSS_COMPILE": "riscv64-unknown-elf-",
        "GDB": "gdb-multiarch"
    },
    "files.associations": {
        "*.h": "c",
        "Makefile.build": "makefile",
        ".clangd": "yaml",
        ".clang-format": "yaml"
    },
    "[c]": {
        "editor.tabSize": 8,
        "editor.insertSpaces": false
    },
    "[makefile]": {
        "editor.tabSize": 8,
        "editor.insertSpaces": false
    },
    "C_Cpp.intelliSenseEngine": "disabled"
}